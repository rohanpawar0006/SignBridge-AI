# SignBridge AI - Frontend Environment Variables
# Leave blank for local development (uses Vite proxy).
# In production on Vercel, set these in Project Settings -> Environment Variables.

# Backend HTTP Base URL (e.g. https://signbridge-backend.onrender.com)
VITE_BACKEND_URL=

# Backend WebSocket Endpoint (e.g. wss://signbridge-backend.onrender.com/ws/gesture)
VITE_WS_URL=
